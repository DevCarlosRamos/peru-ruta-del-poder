{
  "name": "peru-ruta-del-poder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PERÚ: LA RUTA DEL PODER — Juego de mesa digital de estrategia, economía y sátira política peruana (obra original).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b --noEmit",
    "simulate": "tsx src/engine/simulations/simulate.ts",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name peru-ruta-del-poder",
    "db:migrate": "wrangler d1 execute peru-ruta-del-poder-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
